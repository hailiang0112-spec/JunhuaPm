# 复制为 .env 后填写。均为部署密钥（deployment-secret），不要提交到代码仓库。
POSTGRES_PASSWORD=请替换
APP_OWNER_PASSWORD=请替换
APP_RUNTIME_PASSWORD=请替换
DJANGO_SECRET_KEY=请替换为 50 位随机串
ALLOWED_HOSTS=jh.example.com
CSRF_TRUSTED_ORIGINS=https://jh.example.com
COOKIE_SECURE=1
HTTP_PORT=80
# 文件存储：s3（对象存储，推荐）或 local（服务器本地磁盘，须配置异地备份 OFFSITE_TARGET）
FILE_STORAGE=s3
S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
S3_BUCKET=jh-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 首次部署是否灌入演示账号（生产填 0）
SEED_BASE=0
# 备份（技术方案 §7.6）：本机备份目录挂在数据盘；本地存储模式必须配置异地位置
BACKUP_HOST_DIR=/data/jh-backups
# 异地位置：dir = 公司提供的另一台服务器或 NAS，挂载到本机 OFFSITE_HOST_DIR；s3 = 另一个存储桶（不同地域或账号）
OFFSITE_TARGET=
OFFSITE_HOST_DIR=/mnt/jh-offsite
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_BUCKET=
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=
# HTTPS 证书目录（fullchain.pem），备份任务每天检查剩余天数
CERT_HOST_DIR=/etc/nginx/certs
